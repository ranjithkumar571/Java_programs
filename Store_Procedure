Method 3: Using SimpleJdbcCall (Best for Oracle Packages)If your stored procedures reside inside an Oracle Package, or you prefer plain JDBC without JPA overhead, use SimpleJdbcCall.java@Service
public class LegacyDbService {

    private final SimpleJdbcCall jdbcCall;

    public LegacyDbService(DataSource dataSource) {
        this.jdbcCall = new SimpleJdbcCall(dataSource)
                .withCatalogName("EMP_PACKAGE") // Oracle Package Name
                .withProcedureName("GET_SALARY_GRADE");
    }

    public String getSalaryGrade(Long empId) {
        SqlParameterSource in = new MapSqlParameterSource().addValue("emp_id", empId);
        Map<String, Object> out = jdbcCall.execute(in);
        
        return (String) out.get("salary_grade");
    }
}
